# Copy to .env for local development. All optional — the app runs with none
# of these set.

# Where the waitlist sink appends signups. Defaults to .data/waitlist.jsonl
# locally; the container sets /data/waitlist.jsonl.
# WAITLIST_FILE=.data/waitlist.jsonl

# Reported by /version.json. CI bakes the real commit in at image build time.
# GIT_SHA=dev
# BUILD_TIME=

# Raises the GitHub API rate limit used to read each project's published
# version (60/hour unauthenticated, 5000/hour with a token). Unset is fine:
# the site refreshes every 30 minutes and falls back to the version in
# src/server/projects.ts, so nothing breaks without it. A fine-grained token
# with NO scopes is enough — every repo read is public.
# GITHUB_TOKEN=
